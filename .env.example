# Copy to .env and change the values for your host.
# Existing .env files should be edited, not overwritten.

# Jellyfin server
HOST_HOSTNAME=jellyfin
JELLYFIN_UID=1000
JELLYFIN_GID=1000
# Required: host render group ID (getent group render | cut -d: -f3)
JELLYFIN_RENDER_GID=
# Original HTTP binding is 8096:8096. Override host port only if your integrations also use it.
JELLYFIN_HTTP_PORT=8096

# Media paths on the Docker host
JELLYFIN_VIDEOS_DIR=/mnt/NAS/Documents/Videos
JELLYFIN_MUSIC_DIR=/mnt/NAS/Documents/Music
JELLYFIN_CD_FLAC_DIR=/mnt/NAS/Documents/CDリッピング(flac)/

# Optional: advertise an address that clients can reach, e.g. https://media.example.com
# Empty means that no published address is specified.
JELLYFIN_PUBLISHED_SERVER_URL=

# Optional Discord music bot (disabled until explicitly enabled)
# Discord Developer Portal -> Bot -> Token
DISCORD_CLIENT_TOKEN=
# Create a Jellyfin user that can access your music library
JELLYFIN_BOT_USERNAME=
JELLYFIN_BOT_PASSWORD=
# The bot and Jellyfin share the same Compose network by default
JELLYFIN_BOT_SERVER_ADDRESS=http://jellyfin:8096
JELLYFIN_BOT_ALLOW_EVERYONE=false
JELLYFIN_BOT_DISABLE_UPDATE_NOTIFICATIONS=true
JELLYFIN_BOT_IMAGE=ghcr.io/manuel-rw/jellyfin-discord-music-bot:latest

# Optional TV Jellyfin Web patch and TV-network integration
# The TV Compose file is selected explicitly, not loaded on standard HTTP startup.
CECH_MEDIA_NETWORK=cech-media
CECH_JELLYFIN_PATCHED_IMAGE=cech-jellyfin-live-buffer:local

# Optional HTTPS integration (standalone nginx gateway; disabled until enabled)
# Original gateway bindings (default): 7443 (KonomiTV), 8443 (Jellyfin).
# This is an optional gateway to separate services, NOT Jellyfin's native HTTPS.
# Do not run a second gateway on ports already occupied by the existing one.
# Required when using HTTPS; leave the required fields blank until configured.
# Find the certificate group GID with: getent group tailscale-certs
CECH_TLS_CERT_GID=
# DNS hostname on the TLS certificate (e.g. server.example.ts.net)
CECH_TLS_SERVER_NAME=
# Tailscale IPv4 to bind to, e.g. 100.x.y.z
CECH_TLS_BIND=
# KonomiTV hostname/IP and port, accessible within CECH_JELLYFIN_NETWORK
CECH_TLS_KONOMI_UPSTREAM=
CECH_TLS_JELLYFIN_UPSTREAM=jellyfin:8096
# Existing Docker network with access to both HTTP upstream services
CECH_JELLYFIN_NETWORK=
CECH_TLS_CERT_DIR=/etc/tailscale-certs
CECH_TLS_LOCAL_BIND=127.0.0.1
CECH_TLS_KONOMI_HOST_PORT=7443
CECH_TLS_JELLYFIN_HOST_PORT=8443
CECH_TLS_USER=1000:1000
# Optional image override: CECH_TLS_IMAGE=nginx@sha256:...
