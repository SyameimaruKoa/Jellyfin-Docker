# Copy to .env and change the values for your host.
# Existing .env files should be edited, not overwritten.

# Jellyfin server
HOST_HOSTNAME=jellyfin
JELLYFIN_UID=1000
JELLYFIN_GID=1000
# Required: host render group ID (getent group render | cut -d: -f3)
JELLYFIN_RENDER_GID=
JELLYFIN_HTTP_PORT=8096

# Media paths on the Docker host
JELLYFIN_VIDEOS_DIR=/mnt/NAS/Documents/Videos
JELLYFIN_MUSIC_DIR=/mnt/NAS/Documents/Music
JELLYFIN_CD_FLAC_DIR=/mnt/NAS/Documents/CDリッピング(flac)/

# Optional: advertise an address that clients can reach, e.g. https://media.example.com
# Empty means that no published address is specified.
JELLYFIN_PUBLISHED_SERVER_URL=

# Optional Discord music bot (disabled until explicitly enabled)
# Discord Developer Portal -> Bot -> Token
DISCORD_CLIENT_TOKEN=
# Create a Jellyfin user that can access your music library
JELLYFIN_BOT_USERNAME=
JELLYFIN_BOT_PASSWORD=
# The bot and Jellyfin share the same Compose network by default
JELLYFIN_BOT_SERVER_ADDRESS=http://jellyfin:8096
JELLYFIN_BOT_ALLOW_EVERYONE=false
JELLYFIN_BOT_DISABLE_UPDATE_NOTIFICATIONS=true
JELLYFIN_BOT_IMAGE=ghcr.io/manuel-rw/jellyfin-discord-music-bot:latest
