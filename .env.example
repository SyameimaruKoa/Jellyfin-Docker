# このリポジトリは個人用です。
# PC固有の情報・認証情報のみ、ここで設定します。
# 既存の.envを上書きしないこと: cp -n .env.example .env

# Jellyfinのホスト名
HOST_HOSTNAME=jellyfin

# ホストのrenderグループID（必須）
# 確認: getent group render | cut -d: -f3
JELLYFIN_RENDER_GID=

# Jellyfinがクライアントへ通知する公開URL（任意）
JELLYFIN_PUBLISHED_SERVER_URL=

# Discord音楽ボットを使用する場合のみ設定
DISCORD_CLIENT_TOKEN=
JELLYFIN_BOT_USERNAME=
JELLYFIN_BOT_PASSWORD=

# テレビ連携用の従来HTTPSゲートウェイ（7443/8443）の設定
# Jellyfin標準HTTPS（8920）には以下の変数は不要です。
# 標準HTTPSを使う場合は、JellyfinにPFX証明書を設定してください。
# /etc/tailscale-certsを読み取るためのグループID
CECH_TLS_CERT_GID=
# TLS証明書に記載されたホスト名（FQDN）
CECH_TLS_SERVER_NAME=
# 待ち受けるホストのTailscale IPv4
CECH_TLS_BIND=
# KonomiTVとJellyfinの両方に接続できる既存Dockerネットワーク
# 名前が実際の構成と一致していることを確認してください。
CECH_JELLYFIN_NETWORK=
